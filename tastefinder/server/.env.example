# .env.example
# ------------
# Documented configuration keys. Copy to .env and fill in locally.
# NEVER commit a real value for any of these. .env is gitignored.

# Persistence.
#   Local development / tests: SQLite, e.g.
#     DATABASE_URL=sqlite+pysqlite:///./taste_platform.db
#   Deployed: MySQL, e.g.
#     DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
#   Postgres is also supported:
#     DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Install the matching driver extra: pip install -e ".[mysql]" (or "[postgres]").
DATABASE_URL=

# Optional: run the persistence test suite against a real MySQL as well as
# SQLite. Unset, those tests skip rather than fail. See tests/
# test_persistence_repositories.py for why both dialects are exercised.
#   TEST_MYSQL_URL=mysql+pymysql://root:PASSWORD@127.0.0.1:3306/tastefinder
TEST_MYSQL_URL=

# Google Places, used as a live venue-lookup service only, behind an interface.
# Not read until the Places integration is specified (out of scope at bootstrap).
GOOGLE_PLACES_API_KEY=

# Google OAuth. Auth is deliberately not scaffolded yet; these keys are declared
# so the deployment contract is complete.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
