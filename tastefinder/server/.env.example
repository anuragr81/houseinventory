# .env.example
# ------------
# Documented configuration keys. Copy to .env and fill in locally.
# NEVER commit a real value for any of these. .env is gitignored.

# Persistence.
#   Local development / tests: SQLite, e.g.
#     DATABASE_URL=sqlite+pysqlite:///./taste_platform.db
#   Deployed: PostgreSQL, e.g.
#     DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Unset at bootstrap: nothing reads it until the Phase 2 persistence layer.
DATABASE_URL=

# Google Places, used as a live venue-lookup service only, behind an interface.
# Not read until the Places integration is specified (out of scope at bootstrap).
GOOGLE_PLACES_API_KEY=

# Google OAuth. Auth is deliberately not scaffolded yet; these keys are declared
# so the deployment contract is complete.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
